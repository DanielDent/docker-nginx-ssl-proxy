#!/usr/bin/with-contenv bash

if [ -z "$SERVERNAME" ]; then
    echo "ERROR: Server name must be specified..."
    exit 1
fi

CERTBOT_KEY_TYPE="${CERTBOT_KEY_TYPE:-rsa}"
CERTBOT_RSA_KEY_SIZE="${CERTBOT_RSA_KEY_SIZE:-2048}"
CERTBOT_ELLIPTIC_CURVE="${CERTBOT_ELLIPTIC_CURVE:-secp256r1}"

CERTBOT_ARGS=(
    certonly
    --non-interactive
    --webroot
    -w /usr/share/nginx/html
    --agree-tos
    --keep-until-expiring
    --expand
    --register-unsafely-without-email
    --key-type "$CERTBOT_KEY_TYPE"
    -d "$SERVERNAME"
)

if [ -n "$EXTRANAMES" ]; then
    CERTBOT_ARGS+=(-d "$EXTRANAMES")
fi

case "$CERTBOT_KEY_TYPE" in
    rsa)
        CERTBOT_ARGS+=(--rsa-key-size "$CERTBOT_RSA_KEY_SIZE")
        ;;
    ecdsa)
        CERTBOT_ARGS+=(--elliptic-curve "$CERTBOT_ELLIPTIC_CURVE")
        ;;
    *)
        echo "ERROR: CERTBOT_KEY_TYPE must be 'rsa' or 'ecdsa'."
        exit 1
        ;;
esac

if [ -n "$CERTBOT_PREFERRED_CHAIN" ]; then
    CERTBOT_ARGS+=(--preferred-chain "$CERTBOT_PREFERRED_CHAIN")
fi

if [ -n "$CERTBOT_PREFERRED_PROFILE" ]; then
    CERTBOT_ARGS+=(--preferred-profile "$CERTBOT_PREFERRED_PROFILE")
fi

http_hostname_is_reachable() {
    local hostname="$1"
    local address
    local url

    while read -r address; do
        if [[ "$address" == *:* ]]; then
            url="http://[$address]/"
        else
            url="http://$address/"
        fi

        # Resolve with getent, then connect to the literal address so this
        # preflight does not depend on curl's threaded DNS resolver.
        if curl --connect-timeout 1 --max-time 5 -H "Host: $hostname" "$url"; then
            return 0
        fi
    done < <(getent ahosts "$hostname" | awk '$2 == "STREAM" && !seen[$1]++ { print $1 }')

    return 1
}

echo Waiting for Nginx to come up...
until curl --connect-timeout 1 http://127.0.0.1/; do
    sleep 1s
done
echo Nginx has arrived.

echo Waiting for a response from http://${SERVERNAME:-example.com}/
# --dns-servers 8.8.8.8 (ideal curl flag) is not available in default build
until http_hostname_is_reachable "${SERVERNAME:-example.com}"; do
    echo Request to http://${SERVERNAME:-example.com}/ failed.  Until Nginx is visible at this DNS, certificate verification cannot succeed.  To avoid hitting rate limits, this check will repeat every 15s until resolved.
    echo Let\'s Encrypt uses Google\'s DNS servers.  If you have already updated your DNS host, you can flush the Google DNS cache by completing the form at https://developers.google.com/speed/public-dns/cache
    sleep 15s
done
echo Something is responding at  http://${SERVERNAME:-example.com}/

while true; do

    if certbot "${CERTBOT_ARGS[@]}"; then
        LIVE_DIR="/etc/letsencrypt/live/${SERVERNAME:-example.com}"
        # certbot exits 0 even when the certificate was not renewed ("not yet due").
        # Only deploy and reload nginx when the certificate has actually changed,
        # otherwise nginx would be reloaded on every loop iteration.
        if ! cmp -s "$LIVE_DIR/fullchain.pem" /etc/letsencrypt/fullchain-copy.pem; then
            echo "Certificate changed; deploying and reloading nginx."
            cp "$LIVE_DIR/privkey.pem" /etc/letsencrypt/privkey-copy.pem
            cp "$LIVE_DIR/fullchain.pem" /etc/letsencrypt/fullchain-copy.pem
            nginx -s reload
        fi
    else
        if [ -e /etc/letsencrypt/live/${SERVERNAME:-example.com}/fullchain.pem ]; then
            BIGSLEEP="$(( 360 + $(($RANDOM % 360)) ))"m # 6-12 hours
            sleep $BIGSLEEP
        fi
    fi

    SMALLSLEEP="$(( 150 + $(($RANDOM % 300)) ))"s # 2.5-7.5 minutes
    sleep $SMALLSLEEP

done
